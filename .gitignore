data/raw/
data/index/*.ngram
data/llm/*/

# ---------- 大文件 ----------
*.zip
*.tar.gz
*.7z

# ---------- 系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini
docs/archive/
